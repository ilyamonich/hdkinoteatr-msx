{
  "type": "list",
  "title": "HDKinoTeatr",
  "template": {
    "type": "control",
    "layout": "0,0,8,1"
  },
  "items": [
    {
      "type": "control",
      "offset": "0,0,0,0",
      "action": "load",
      "label": "🎬 Все фильмы",
      "icon": "movie",
      "url": "/api/movies"
    },
    {
      "type": "control",
      "offset": "0,1,0,0",
      "action": "load",
      "label": "📂 Категории",
      "icon": "folder",
      "url": "/api/categories"
    },
    {
      "type": "control",
      "offset": "0,2,0,0",
      "action": "input",
      "label": "🔍 Поиск",
      "icon": "search",
      "input": {
        "prompt": "Введите название фильма",
        "submit": "/api/search?q={query}"
      }
    }
  ]
}
